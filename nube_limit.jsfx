desc:Nube Limit - limitador brickwall (true peak 4x, lookahead, 5 estilos, recorte suave, LUFS)
//tags: limiter maximizer brickwall true-peak loudness lufs mastering clipper
//author: Kev Meneses + Claude (Claude Code)
//license: GPL-3.0-or-later
//version: 1.0.0

slider1:0<0,24,0.1>-Ganancia (dB)
slider2:-1<-12,0,0.1>-Techo (dB)
slider3:100<1,1000,1:log=100>-Release (ms)
slider4:3<0,10,0.1>-Lookahead (ms)
slider5:0<0,4,1{Transparente,Punch,Denso,Agresivo,Seguro}>-Estilo
slider6:1<0,1,1{Apagado,Encendido}>-Auto release
slider7:100<0,100,1>-Enlace estereo (%)
slider8:1<0,1,1{Apagado (pico de muestra),Encendido (4x)}>-Pico real (true peak)
slider9:0<0,100,1>-Recorte suave (%)
slider10:0<0,1,1{Apagado,Encendido}>-Igual volumen (comparar)
slider11:0<0,1,1{Normal,Solo lo que se quita}>-Escuchar cambios
slider12:0<0,9,1{-,Master -14 LUFS (streaming),Master fuerte (-9 LUFS),Bus de bateria (punch),Kick - recorte del golpe,808 / bajo - control,Voz - control de picos,Seguridad (solo picos),Agresivo / clipper (trap),Por defecto}>-Cargar preset
slider13:-70<-70,10,0.01>-Lectura: LUFS integrado
slider14:-100<-100,30,0.01>-Lectura: pico real maximo (dBTP)

in_pin:Entrada L
in_pin:Entrada R
out_pin:Salida L
out_pin:Salida R

options:gfx_hz=60 no_meter

@init
ext_noinit = 1;
gfx_ext_retina = 1;

RN = 4096; RM = RN - 1;          // anillos (potencia de 2)
dlA = 0; dlB = 4096;             // audio retrasado
qvA = 8192; qiA = 12288; qvB = 16384; qiB = 20480;    // maximo deslizante (cola monotona)
bxA = 24576; bxB = 28672;        // promedio deslizante (caja)
tph = 33000;                     // coeficientes del sobremuestreo 4x: 3 fases x 16
tbIA = 33100; tbIB = 33140; tbOA = 33180; tbOB = 33220;   // historiales de 16 (x2) para el pico real
qsA = 33260; qsB = 33264;        // cabeza / cola de cada cola monotona
kfs = 33300;                     // filtros K (LUFS): coef. y estados
NB = 30; blk = 33400;            // bloques de 100 ms (energia) para LUFS M / S
NBIN = 800; binC = 34000; binE = 35000;   // histograma para LUFS integrado (-70..+10, 0.1 LU)
NH = 1000; histIn = 36000; histOut = 37000; histGR = 38000;
hitmem = 40000;

// ---------------------------------------------------------------- utilidades
function clamp(x, a, b) ( x < a ? a : x > b ? b : x );
function db2a(x) ( 10 ^ (x / 20) );
function nlog(v, a, b) ( log(v / a) / log(b / a) );
function dlog(n, a, b) ( a * (b / a) ^ n );
function nlin(v, a, b) ( (v - a) / (b - a) );
function dlin(n, a, b) ( a + (b - a) * n );

function sset(i, v)
(
  i == 1 ? ( slider1 = v; slider_automate(slider1); ) : i == 2 ? ( slider2 = v; slider_automate(slider2); ) :
  i == 3 ? ( slider3 = v; slider_automate(slider3); ) : i == 4 ? ( slider4 = v; slider_automate(slider4); ) :
  i == 5 ? ( slider5 = v; slider_automate(slider5); ) : i == 6 ? ( slider6 = v; slider_automate(slider6); ) :
  i == 7 ? ( slider7 = v; slider_automate(slider7); ) : i == 8 ? ( slider8 = v; slider_automate(slider8); ) :
  i == 9 ? ( slider9 = v; slider_automate(slider9); ) : i == 10 ? ( slider10 = v; slider_automate(slider10); ) :
  i == 11 ? ( slider11 = v; slider_automate(slider11); ) : i == 12 ? ( slider12 = v; slider_automate(slider12); );
);

// ---------------------------------------------------------------- pico real: sinc con ventana de Hann, 16 coef. por fase
function tp_init() local(p, j, t, s, w, sum)
(
  p = 1;
  loop(3,
    sum = 0; j = 0;
    loop(16,
      t = j - 7 - p / 4;
      s = abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t);
      w = 0.5 + 0.5 * cos($pi * t / 8.5);
      tph[(p - 1) * 16 + j] = s * w; sum += s * w; j += 1;
    );
    j = 0; loop(16, tph[(p - 1) * 16 + j] /= sum; j += 1; );
    p += 1;
  );
);
// agrega x al historial b (32 casillas, escrito dos veces) y devuelve el pico entre las muestras n-8 y n-7
function tp_push(x, b) local(w, i0, s1, s2, s3, j, v)
(
  w = b[34]; b[w] = x; b[w + 16] = x; w = (w + 1) & 15; b[34] = w;
  i0 = b + w;                       // i0[0] = la mas vieja (n-15), i0[15] = la nueva
  s1 = s2 = s3 = 0; j = 0;
  loop(16, v = i0[j]; s1 += tph[j] * v; s2 += tph[16 + j] * v; s3 += tph[32 + j] * v; j += 1; );
  max(max(abs(s1), abs(s2)), abs(s3));
);

// ---------------------------------------------------------------- loudness (BS.1770): filtro K por canal
function bq_set(c, b0, b1, b2, a0, a1, a2) ( c[0] = b0 / a0; c[1] = b1 / a0; c[2] = b2 / a0; c[3] = a1 / a0; c[4] = a2 / a0; );
function bq(x, c, s) local(y)
( y = c[0] * x + s[0]; s[0] = c[1] * x - c[3] * y + s[1]; s[1] = c[2] * x - c[4] * y; y; );
// mismas formulas que libebur128: a 48 kHz dan exactamente los coeficientes de la norma
function kw_init() local(K, Vh, Vb, Q, a0)
(
  K = tan($pi * 1681.974450955533 / srate); Q = 0.7071752369554196;
  Vh = 10 ^ (3.999843853973347 / 20); Vb = Vh ^ 0.4996667741545416;
  a0 = 1 + K / Q + K * K;
  bq_set(kfs, Vh + Vb * K / Q + K * K, 2 * (K * K - Vh), Vh - Vb * K / Q + K * K, a0, 2 * (K * K - 1), 1 - K / Q + K * K);
  K = tan($pi * 38.13547087602444 / srate); Q = 0.5003270373238773;
  a0 = 1 + K / Q + K * K;
  bq_set(kfs + 5, 1, -2, 1, 1, 2 * (K * K - 1) / a0, (1 - K / Q + K * K) / a0);
);
function lufs_reset()
(
  memset(binC, 0, NBIN); memset(binE, 0, NBIN); memset(blk, 0, NB);
  lu_acc = 0; lu_n = 0; lu_nb = 0; lu_bw = 0; lu_i = -70; tp_max = 0; lu_m = lu_s = -70;
  slider13 = -70; slider14 = -100;
);
// cada 100 ms: cierra un bloque, calcula M (400 ms) y S (3 s) y suma M al histograma
function lufs_block() local(i, e, n, bi, tot, zt, rel, eg, ng)
(
  blk[lu_bw] = lu_acc / max(lu_n, 1); lu_bw = (lu_bw + 1) % NB; lu_nb = min(lu_nb + 1, NB);
  lu_acc = 0; lu_n = 0;
  e = 0; i = 1; loop(4, e += blk[(lu_bw - i + NB) % NB]; i += 1; ); e /= 4;
  lu_m = lu_nb >= 4 ? -0.691 + 10 * log10(e + 0.0000000000001) : -70;
  lu_nb >= 4 && lu_m > -70 ? (
    bi = clamp(floor((lu_m + 70) * 10), 0, NBIN - 1); binC[bi] += 1; binE[bi] += e;
  );
  e = 0; i = 1; loop(30, e += blk[(lu_bw - i + NB) % NB]; i += 1; );
  lu_s = lu_nb >= 30 ? -0.691 + 10 * log10(e / 30 + 0.0000000000001) : lu_m;
  // integrado: compuerta absoluta (-70) y relativa (-10 LU)
  tot = 0; n = 0; i = 0; loop(NBIN, n += binC[i]; tot += binE[i]; i += 1; );
  n > 0 ? (
    zt = -0.691 + 10 * log10(tot / n); rel = zt - 10;
    bi = clamp(ceil((rel + 70) * 10), 0, NBIN - 1);
    eg = 0; ng = 0; i = bi; loop(NBIN - bi, ng += binC[i]; eg += binE[i]; i += 1; );
    lu_i = ng > 0 ? -0.691 + 10 * log10(eg / ng) : -70;
    slider13 = clamp(lu_i, -70, 10);
  );
);

// ---------------------------------------------------------------- estilos
// box = fraccion del lookahead usada para suavizar (menos = ataque mas tarde, mas punch)
// rlm = multiplicador del release, knee = rodilla en dB alrededor del techo
function st_box(s) ( s == 1 ? 0.35 : s == 3 ? 0.6 : 1 );
function st_rel(s) ( s == 1 ? 0.6 : s == 2 ? 1.6 : s == 3 ? 0.4 : s == 4 ? 1.5 : 1 );
function st_knee(s) ( s == 2 ? 3 : s == 3 ? 1 : 0 );

function q_reset(qs) ( qs[0] = 0; qs[1] = 0; );
function update_params() local(nn, mm, i)
(
  gin = db2a(slider1);
  ceil_db = slider2; ceil_a = db2a(slider2);
  style = slider5;
  kneeW = st_knee(style);
  rl = max(slider3, 1) * st_rel(style);
  autorel = slider6;
  relc = exp(-1 / (rl * (autorel ? 0.35 : 1) * 0.001 * srate));
  slowup = 1 - exp(-1 / (0.3 * srate));
  slowdn = exp(-1 / (rl * 3 * 0.001 * srate));
  nn = max(1, floor(slider4 * 0.001 * srate + 0.5)); nn = min(nn, 2000);
  mm = max(1, floor(nn * st_box(style) + 0.5));
  (nn != la_n || mm != bx_m) ? (
    la_n = nn; bx_m = mm;
    memset(bxA, 0, RN); memset(bxB, 0, RN); bsA = bsB = 0;
    q_reset(qsA); q_reset(qsB);
  );
  pdc_delay = la_n - 1 + 8; pdc_bot_ch = 0; pdc_top_ch = 2;
  lnk = slider7 / 100;
  tp_on = slider8;
  clipa = slider9 / 100;
  unity = slider10; dlt = slider11;
  hslot = floor(0.006 * srate);
  sm = 1 - exp(-1 / (0.02 * srate));
  lu_len = floor(0.1 * srate);
);

// recorte suave: lineal hasta -6 dB del techo, rodilla cuadratica, nunca pasa del techo
function sclip(x) local(a, c)
(
  a = abs(x); c = ceil_a;
  a <= 0.5 * c ? x : (a >= 1.5 * c ? c : a - (a - 0.5 * c) * (a - 0.5 * c) / (2 * c)) * sign(x);
);

// reduccion necesaria (dB, positiva) para un pico p (lineal)
function need(p) local(L, o)
(
  L = 20 * log10(p + 0.0000000001); o = L - ceil_db;
  kneeW <= 0 ? max(o, 0) : (o <= -kneeW ? 0 : o >= kneeW ? o : (o + kneeW) * (o + kneeW) / (4 * kneeW));
);

// maximo deslizante de largo la_n (cola monotona). qs[0] = cabeza, qs[1] = cola
function slmax(v, qv, qi, qs, n) local(h, t)
(
  h = qs[0]; t = qs[1];
  while (t != h && qv[(t - 1) & RM] <= v) ( t = (t - 1) & RM; );
  qv[t] = v; qi[t] = n; t = (t + 1) & RM;
  while (qi[h] <= n - la_n) ( h = (h + 1) & RM; );
  qs[0] = h; qs[1] = t;
  qv[h];
);

tp_init(); kw_init();
upd = 0; a_w = 0; a_n = 0; la_n = -1; bx_m = -1;
yA = yB = ysA = ysB = 0;
_i = 0; loop(NH, histIn[_i] = histOut[_i] = -200; histGR[_i] = 0; _i += 1; );
update_params();
lufs_reset();
a_ug = 1 / gin;

// ---------------------------------------------------------------- presets
NPRESETS = 9;
function preset_name(n)
(
  n == 1 ? "Master -14 LUFS (streaming)" :
  n == 2 ? "Master fuerte (-9 LUFS)" :
  n == 3 ? "Bus de bateria (punch)" :
  n == 4 ? "Kick - recorte del golpe" :
  n == 5 ? "808 / bajo - control" :
  n == 6 ? "Voz - control de picos" :
  n == 7 ? "Seguridad (solo picos)" :
  n == 8 ? "Agresivo / clipper (trap)" :
  n == 9 ? "Por defecto" : "";
);
// pr(estilo, ganancia, techo, release, lookahead, auto release, recorte)
function pr(st, g, c, r, la, ar, cl)
( sset(5, st); sset(1, g); sset(2, c); sset(3, r); sset(4, la); sset(6, ar); sset(9, cl); );
function load_preset(n)
(
  pr(0, 0, -1, 100, 3, 1, 0); sset(7, 100); sset(8, 1); sset(10, 0); sset(11, 0);
  n == 1 ? pr(0, 4, -1, 120, 3, 1, 0) :
  n == 2 ? pr(2, 9, -1, 60, 3, 1, 30) :
  n == 3 ? pr(1, 4, -3, 30, 1.5, 0, 10) :
  n == 4 ? pr(1, 0, -3.5, 10, 0.5, 0, 0) :
  n == 5 ? pr(4, 3, -2, 80, 5, 1, 0) :
  n == 6 ? pr(0, 0, -6, 20, 1, 0, 0) :
  n == 7 ? pr(4, 0, -0.3, 200, 5, 1, 0) :
  n == 8 ? pr(3, 8, -0.8, 30, 2, 0, 60);
  upd = 1;
);

@slider
slider12 > 0 ? ( _pn = floor(slider12 + 0.5); slider12 = 0; slider_automate(slider12); load_preset(_pn); );
update_params();

@block
upd ? ( upd = 0; update_params(); );
rst_lufs ? ( rst_lufs = 0; lufs_reset(); );
// al empezar a reproducir se reinicia el integrado
_ps = play_state & 1; _ps && !last_ps ? lufs_reset(); last_ps = _ps;

@sample
a_inL = spl0; a_inR = spl1;
a_ug += (1 / gin - a_ug) * sm;

// ganancia de entrada y recorte suave
a_xA = spl0 * gin; a_xB = spl1 * gin;
clipa > 0 ? ( a_xA += (sclip(a_xA) - a_xA) * clipa; a_xB += (sclip(a_xB) - a_xB) * clipa; );

// pico (real) de cada canal, alineado con la muestra n-8
a_pA = tp_push(a_xA, tbIA); a_pB = tp_push(a_xB, tbIB);
a_oA = tbIA[(tbIA[34] + 7) & 15]; a_oB = tbIB[(tbIB[34] + 7) & 15];   // x[n-8]
tp_on ? (
  a_kA = max(max(abs(a_oA), a_pA), a_ppA); a_ppA = a_pA;
  a_kB = max(max(abs(a_oB), a_pB), a_ppB); a_ppB = a_pB;
) : ( a_kA = abs(a_oA); a_kB = abs(a_oB); );

a_tA = need(a_kA); a_tB = need(a_kB);
a_m = max(a_tA, a_tB);
a_tA += (a_m - a_tA) * lnk; a_tB += (a_m - a_tB) * lnk;

// maximo sobre el lookahead -> release (ataque instantaneo) -> promedio sobre la caja
a_hA = slmax(a_tA, qvA, qiA, qsA, a_n); a_hB = slmax(a_tB, qvB, qiB, qsB, a_n);
a_n += 1;
yA = a_hA >= yA ? a_hA : a_hA + (yA - a_hA) * relc;
yB = a_hB >= yB ? a_hB : a_hB + (yB - a_hB) * relc;
autorel ? (
  ysA = a_hA > ysA ? ysA + (a_hA - ysA) * slowup : a_hA + (ysA - a_hA) * slowdn;
  ysB = a_hB > ysB ? ysB + (a_hB - ysB) * slowup : a_hB + (ysB - a_hB) * slowdn;
  a_yA = max(yA, min(ysA, a_hA + 40)); a_yB = max(yB, min(ysB, a_hB + 40));
) : ( a_yA = yA; a_yB = yB; );
a_bi = a_w & RM; a_bo = (a_w - bx_m) & RM;
bsA += a_yA - bxA[a_bo]; bxA[a_bi] = a_yA;
bsB += a_yB - bxB[a_bo]; bxB[a_bi] = a_yB;
a_grA = max(bsA / bx_m, 0); a_grB = max(bsB / bx_m, 0);
(a_n & 65535) == 0 ? (     // corrige el error acumulado de la suma
  bsA = bsB = 0; _j = 0; loop(bx_m, bsA += bxA[(a_w - _j) & RM]; bsB += bxB[(a_w - _j) & RM]; _j += 1; );
);

// audio retrasado la_n - 1 (y 8 del pico real ya vienen en a_o)
dlA[a_w & RM] = a_oA; dlB[a_w & RM] = a_oB;
a_r = (a_w - (la_n - 1)) & RM;
a_dA = dlA[a_r]; a_dB = dlB[a_r];
a_w += 1;

a_gA = exp(-0.1151292546 * a_grA); a_gB = exp(-0.1151292546 * a_grB);
a_yLa = a_dA * a_gA; a_yRa = a_dB * a_gB;
// seguridad final: nunca pasa del techo (pico de muestra)
a_yLa = clamp(a_yLa, -ceil_a, ceil_a); a_yRa = clamp(a_yRa, -ceil_a, ceil_a);

dlt ? ( spl0 = a_dA - a_yLa; spl1 = a_dB - a_yRa; ) :
( unity ? ( spl0 = a_yLa * a_ug; spl1 = a_yRa * a_ug; ) : ( spl0 = a_yLa; spl1 = a_yRa; ); );

// medidores: pico real de la salida y loudness
a_q = max(tp_push(a_yLa, tbOA), tp_push(a_yRa, tbOB));
a_q = max(a_q, max(abs(a_yLa), abs(a_yRa)));
a_q > tp_max ? ( tp_max = a_q; slider14 = clamp(20 * log10(a_q + 0.0000000001), -100, 30); );
a_x = bq(bq(a_yLa, kfs, kfs + 10), kfs + 5, kfs + 12);
a_z = bq(bq(a_yRa, kfs, kfs + 14), kfs + 5, kfs + 16);
// el loudness solo cuenta mientras suena (reproduccion, grabacion o render): detenido se congela
(play_state & 5) ? ( lu_acc += a_x * a_x + a_z * a_z; (lu_n += 1) >= lu_len ? lufs_block(); );

a_gr = max(a_grA, a_grB);
gr_now = a_gr;
a_x = max(abs(a_inL), abs(a_inR)); a_x > m_in ? m_in = a_x;
a_x *= gin; a_x > h_in ? h_in = a_x;     // historial: entrada con ganancia y sin recorte
a_x = max(abs(a_yLa), abs(a_yRa)); a_x > h_out ? h_out = a_x; a_x > m_out ? m_out = a_x;
a_gr > h_gr ? h_gr = a_gr; a_gr > m_gr ? m_gr = a_gr;
(a_hc -= 1) <= 0 ? (
  a_hc = hslot;
  histIn[hw] = 20 * log10(h_in + 0.0000001);
  histOut[hw] = 20 * log10(h_out + 0.0000001);
  histGR[hw] = h_gr;
  (hw += 1) >= NH ? hw = 0;
  h_in = h_out = h_gr = 0;
);

@gfx 1000 640
// ======================================================================= interfaz
SC = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
WW = gfx_w; WH = gfx_h;

function fnt(i) (
  i == 1 ? gfx_setfont(1, "Helvetica Neue", 13 * SC) :
  i == 2 ? gfx_setfont(2, "Helvetica Neue", 11 * SC) :
  i == 3 ? gfx_setfont(3, "Helvetica Neue", 17 * SC, 'b') :
  i == 4 ? gfx_setfont(4, "Helvetica Neue", 10 * SC, 'b') :
  i == 6 ? gfx_setfont(6, "Helvetica Neue", 15 * SC, 'b') :
  i == 7 ? gfx_setfont(7, "Helvetica Neue", 24 * SC, 'b') :
           gfx_setfont(5, "Helvetica Neue", 12 * SC, 'b');
);
function style_rgb(st, a)
(
  st == 0 ? gfx_set(0.42, 0.78, 1.00, a) :
  st == 1 ? gfx_set(1.00, 0.62, 0.30, a) :
  st == 2 ? gfx_set(0.80, 0.58, 1.00, a) :
  st == 3 ? gfx_set(1.00, 0.42, 0.42, a) :
            gfx_set(0.47, 0.88, 0.60, a);
);
function acc(a) ( style_rgb(slider5, a); );
function style_name(st) ( st == 0 ? "Transparente" : st == 1 ? "Punch" : st == 2 ? "Denso" : st == 3 ? "Agresivo" : "Seguro"; );

function hit_add(x, y, w, h, id) local(p)
( hit_n < 200 ? ( p = hitmem + hit_n * 5; p[0] = x; p[1] = y; p[2] = w; p[3] = h; p[4] = id; hit_n += 1; ); );
function hit_find(mx, my) local(i, p, r)
(
  r = 0; i = hit_n - 1;
  while (i >= 0 && r == 0) (
    p = hitmem + i * 5;
    (mx >= p[0] && mx < p[0] + p[2] && my >= p[1] && my < p[1] + p[3]) ? r = p[4];
    i -= 1;
  );
  r;
);
function frect(x, y, w, h, r) (
  r = min(r, min(w, h) * 0.5);
  gfx_rect(x + r, y, w - 2 * r, h, 1);
  gfx_rect(x, y + r, r, h - 2 * r, 1);
  gfx_rect(x + w - r, y + r, r, h - 2 * r, 1);
  gfx_circle(x + r, y + r, r, 1, 1); gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1); gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);
function text_c(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 1 | 4, x + w, y + h); );
function text_l(str, x, y, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 4, x + 2000, y + h); );
function text_r(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 2 | 4, x + w, y + h); );
function fmt_ms(d, t) ( t < 10 ? sprintf(d, "%.1f ms", t) : t < 1000 ? sprintf(d, "%d ms", floor(t + 0.5)) : sprintf(d, "%.2f s", t / 1000); );

function button(id, x, y, w, h, str, on)
(
  hov = hover_id == id;
  on ? acc(1) : gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  on ? gfx_set(0.07, 0.08, 0.10, 1) : gfx_set(0.86, 0.88, 0.92, 1);
  fnt(1); text_c(str, x, y, w, h);
  hit_add(x, y, w, h, id);
);
function dropdown(id, x, y, w, h, label, str)
(
  hov = hover_id == id;
  gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1);
  text_l(label, x + 8 * SC, y, h);
  strlen(label) ? gfx_measurestr(label, _tw, _th) : _tw = -4 * SC;
  fnt(1); gfx_set(0.90, 0.92, 0.96, 1);
  text_l(str, x + 12 * SC + _tw, y, h);
  gfx_set(0.55, 0.58, 0.65, 1);
  _cx = x + w - 12 * SC; _cy = y + h * 0.5;
  gfx_triangle(_cx - 4 * SC, _cy - 2 * SC, _cx + 4 * SC, _cy - 2 * SC, _cx, _cy + 3 * SC);
  hit_add(x, y, w, h, id);
);
function knob(id, cx, cy, r, label, str, n, bip, enabled) local(a0, a1, av, i, rr)
(
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; av = a0 + (a1 - a0) * clamp(n, 0, 1);
  fnt(2); gfx_set(0.62, 0.65, 0.72, enabled ? 1 : 0.4);
  text_c(label, cx - 50 * SC, cy - r - 18 * SC, 100 * SC, 14 * SC);
  gfx_set(0.13, 0.14, 0.18, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.26, 0.28, 0.34, 1);
  i = 0; loop(3 * SC, gfx_arc(cx, cy, r - 2 * SC - i, a0, a1, 1); i += 1; );
  acc(enabled ? 1 : 0.35);
  i = 0; loop(3 * SC, rr = r - 2 * SC - i;
    bip ? ( av < 0 ? gfx_arc(cx, cy, rr, av, 0, 1) : gfx_arc(cx, cy, rr, 0, av, 1); )
        : gfx_arc(cx, cy, rr, a0, av, 1);
    i += 1; );
  gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.4);
  gfx_line(cx + sin(av) * r * 0.25, cy - cos(av) * r * 0.25, cx + sin(av) * (r - 6 * SC), cy - cos(av) * (r - 6 * SC), 1);
  hover_id == id ? ( gfx_set(1, 1, 1, 0.12); gfx_circle(cx, cy, r + 2 * SC, 0, 1); );
  fnt(1); gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.45);
  text_c(str, cx - 50 * SC, cy + r + 3 * SC, 100 * SC, 16 * SC);
  hit_add(cx - r - 8 * SC, cy - r - 4 * SC, 2 * r + 16 * SC, 2 * r + 24 * SC, id);
);

// ---------------------------------------------------------- controles: id -> slider, minimo, maximo, log, defecto, paso
function ctl_info(id)
(
  id == 1 ? ( ci_s = 1; ci_a = 0; ci_b = 24; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 2 ? ( ci_s = 2; ci_a = -12; ci_b = 0; ci_l = 0; ci_d = -1; ci_p = 0.1; ) :
  id == 3 ? ( ci_s = 3; ci_a = 1; ci_b = 1000; ci_l = 1; ci_d = 100; ci_p = 1; ) :
  id == 4 ? ( ci_s = 4; ci_a = 0; ci_b = 10; ci_l = 0; ci_d = 3; ci_p = 0.1; ) :
  id == 5 ? ( ci_s = 9; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 1; ) :
  id == 6 ? ( ci_s = 7; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 100; ci_p = 1; ) :
  ci_s = 0;
);
function ctl_get(id) local(v)
( ctl_info(id); v = slider(ci_s); ci_l ? nlog(v, ci_a, ci_b) : nlin(v, ci_a, ci_b); );
function ctl_setv(id, v)
(
  ctl_info(id);
  v = clamp(floor(v / ci_p + 0.5) * ci_p, ci_a, ci_b);
  sset(ci_s, v); upd = 1;
);
function ctl_set(id, n) ( ctl_info(id); n = clamp(n, 0, 1); ctl_setv(id, ci_l ? dlog(n, ci_a, ci_b) : dlin(n, ci_a, ci_b)); );
function ctl_default(id) ( ctl_info(id); ctl_setv(id, ci_d); );

// ---------------------------------------------------------- ayudas
function style_desc(st, line)
(
  st == 0 ? ( line == 0 ? "Limpio y abierto: release que se adapta al material." : "Para master y casi todo. No cambia el sonido." ) :
  st == 1 ? ( line == 0 ? "Ataque tardio: deja pasar el inicio del golpe (kick," : "snare) antes de bajar. Bateria y beats con pegada." ) :
  st == 2 ? ( line == 0 ? "Rodilla de 3 dB y release mas largo: empieza a apretar" : "antes del techo. Pega la mezcla, suena mas densa." ) :
  st == 3 ? ( line == 0 ? "Release corto y rodilla corta: maximo volumen." : "Puede distorsionar un poco (trap, drill, EDM)." ) :
            ( line == 0 ? "Lookahead completo y release lento: lo mas limpio." : "Para seguridad (solo picos) y graves (808, bajo)." );
);
function hint_for(id)
(
  id == 1 ? strcpy(#hint, "Ganancia: cuanto sube la senal contra el techo. Mas ganancia = mas fuerte y mas limitacion. Tambien: arrastra en la grafica.") :
  id == 2 ? strcpy(#hint, "Techo: nivel maximo de salida. -1 dB es lo recomendado para streaming (con pico real encendido).") :
  id == 3 ? strcpy(#hint, "Release: que tan rapido suelta. Corto = mas fuerte pero distorsiona graves; largo = mas limpio. Con Auto se adapta.") :
  id == 4 ? strcpy(#hint, "Lookahead: mira el audio antes para bajar a tiempo (brickwall). 1-5 ms es lo usual. Agrega latencia (REAPER la compensa).") :
  id == 5 ? strcpy(#hint, "Recorte suave: redondea los picos antes del limitador (clipper). Mas fuerte y con pegada, pero agrega distorsion.") :
  id == 6 ? strcpy(#hint, "Enlace estereo: 100% = ambos lados bajan igual (la imagen no se mueve). 0% = cada lado por separado.") :
  id == 20 ? strcpy(#hint, "Auto release: rapido despues de picos sueltos y lento cuando limita seguido. Evita el bombeo y la distorsion.") :
  id == 21 ? strcpy(#hint, "Pico real: mira tambien entre las muestras (4x), como los medidores de streaming. Necesario para un techo de -1 dBTP.") :
  id == 22 ? strcpy(#hint, "Igual volumen: baja la salida lo mismo que subiste la ganancia, para comparar si el limitador suena mejor o solo mas fuerte.") :
  id == 23 ? strcpy(#hint, "Escuchar cambios: suena SOLO lo que el limitador quita. Si se escucha musica entera (no solo 'clics'), te estas pasando.") :
  id == 30 ? strcpy(#hint, "Presets: puntos de partida para master, bateria, kick, 808 y voz. Para guardar los tuyos usa el + de REAPER.") :
  (id >= 40 && id <= 44) ? (
    strcpy(#hint, style_name(id - 40)); strcat(#hint, ": "); strcat(#hint, style_desc(id - 40, 0)); strcat(#hint, " "); strcat(#hint, style_desc(id - 40, 1));
  ) :
  id == 100 ? strcpy(#hint, "Grafica: gris = entrada (con ganancia), azul = salida, rojo = lo que se quita. Arrastra arriba/abajo = ganancia | clic der. = presets") :
  id == 101 ? strcpy(#hint, "Techo: arrastra la linea arriba/abajo. Doble clic = -1 dB.") :
  id == 102 ? strcpy(#hint, "Loudness (LUFS): M = 400 ms, S = 3 s, I = integrado (se reinicia al dar play o con clic). Streaming normaliza a -14 LUFS.") :
  id == 103 ? strcpy(#hint, "Medidores: entrada, reduccion (GR) y salida, con el maximo arriba. Clic = reiniciar maximos.") :
  strcpy(#hint, "Nube Limit: elige un estilo, sube la Ganancia hasta el volumen que quieres y deja el Techo en -1 dB. Pasa el mouse para ver que hace cada cosa.");
);
function menu_presets() local(r, i)
(
  #m = "#PRESETS DE NUBE LIMIT";
  i = 1; loop(NPRESETS, strcat(#m, "|"); strcat(#m, preset_name(i)); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r >= 2 ? load_preset(r - 1);
);

// ======================================================================= layout
TOPH = 44 * SC; PANH = 150 * SC; FOOTH = 26 * SC;
dy = TOPH + 10 * SC;
dh = WH - TOPH - PANH - FOOTH - 20 * SC; dh < 140 * SC ? dh = 140 * SC;
LW = 170 * SC; lx0 = WW - 14 * SC - LW;            // panel de loudness
MW = 96 * SC; mx0 = lx0 - 12 * SC - MW;           // medidores
hx = 40 * SC; hgw = mx0 - 14 * SC - hx; hy = dy; hh = dh;
py = dy + dh + 10 * SC;
HTOP = 12; HBOT = -36;
function h2y(d) ( hy + hh * clamp((HTOP - d) / (HTOP - HBOT), 0, 1) );

// ======================================================================= mouse
mx = mouse_x; my = mouse_y;
lb = mouse_cap & 1; rb = mouse_cap & 2; shift = mouse_cap & 8;
hover_id = drag ? drag_id : hit_find(mx, my);

lb && !last_lb ? (
  _now = time_precise();
  dbl = _now - last_t < 0.35 && abs(mx - last_x) < 6 * SC && abs(my - last_y) < 6 * SC;
  last_t = dbl ? 0 : _now; last_x = mx; last_y = my;
  (hover_id >= 1 && hover_id <= 6) ? (
    dbl ? ctl_default(hover_id) : ( drag = 1; drag_id = hover_id; drag_my = my; drag_n = ctl_get(hover_id); );
  ) : hover_id == 100 ? (
    dbl ? ctl_default(1) : ( drag = 1; drag_id = 100; drag_my = my; drag_v = slider1; );
  ) : hover_id == 101 ? (
    dbl ? ctl_default(2) : ( drag = 1; drag_id = 101; drag_my = my; drag_v = slider2; );
  ) : hover_id == 102 ? ( rst_lufs = 1; )
    : hover_id == 103 ? ( m_in = m_out = m_gr = 0; pk_in = pk_out = pk_gr = 0; )
    : hover_id == 20 ? ( sset(6, !slider6); upd = 1; )
    : hover_id == 21 ? ( sset(8, !slider8); upd = 1; )
    : hover_id == 22 ? ( sset(10, !slider10); upd = 1; )
    : hover_id == 23 ? ( sset(11, !slider11); upd = 1; )
    : hover_id == 30 ? menu_presets()
    : (hover_id >= 40 && hover_id <= 44) ? ( sset(5, hover_id - 40); upd = 1; );
);
lb && drag ? (
  _k = shift ? 0.1 : 1;
  (drag_id >= 1 && drag_id <= 6) ? ctl_set(drag_id, drag_n + (drag_my - my) / (220 * SC) * _k) :
  drag_id == 100 ? ctl_setv(1, drag_v + (drag_my - my) / hh * (HTOP - HBOT) * 0.5 * _k) :
  drag_id == 101 ? ctl_setv(2, drag_v - (my - drag_my) / hh * (HTOP - HBOT) * _k);
);
!lb ? drag = 0;
rb && !last_rb ? ( (hover_id == 100 || hover_id == 101) ? menu_presets(); );
mouse_wheel != 0 ? (
  _w = mouse_wheel / 120;
  (hover_id >= 1 && hover_id <= 6) ? ctl_set(hover_id, ctl_get(hover_id) + _w * (shift ? 0.002 : 0.012)) :
  hover_id == 100 ? ctl_setv(1, slider1 + _w * (shift ? 0.1 : 0.5)) :
  hover_id == 101 ? ctl_setv(2, slider2 + _w * (shift ? 0.1 : 0.5));
  mouse_wheel = 0;
);
last_lb = lb; last_rb = rb;

// ======================================================================= dibujo
hit_n = 0;
gfx_set(0.075, 0.082, 0.105, 1); gfx_rect(0, 0, WW, WH, 1);

// ---- barra superior
gfx_set(0.10, 0.11, 0.14, 1); gfx_rect(0, 0, WW, TOPH, 1);
fnt(3); gfx_set(0.62, 0.80, 1.0, 1); text_l("NUBE", 14 * SC, 0, TOPH);
gfx_measurestr("NUBE ", _tw, _th);
gfx_set(0.93, 0.94, 0.97, 1); text_l("LIMIT", 14 * SC + _tw, 0, TOPH);
_x = 130 * SC; _y = 9 * SC; _h = 26 * SC;
dropdown(30, _x, _y, 116 * SC, _h, "", "Presets"); _x += 124 * SC;
button(21, _x, _y, 132 * SC, _h, slider8 ? "Pico real 4x" : "Pico de muestra", slider8); _x += 138 * SC;
button(22, _x, _y, 120 * SC, _h, "Igual volumen", slider10); _x += 126 * SC;
button(23, _x, _y, 140 * SC, _h, "Escuchar cambios", slider11); _x += 146 * SC;
_x + 160 * SC < WW ? (
  grd = max(gr_now, grd - 0.25);
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1); text_r("REDUCCION", WW - 210 * SC, _y, 100 * SC, _h);
  fnt(6); gfx_set(1.0, 0.50, 0.44, 1);
  sprintf(#s, "%.1f dB", -grd); text_r(#s, WW - 104 * SC, _y, 90 * SC, _h);
);

// ---- grafica de historial (estilo onda: entrada gris, salida azul, rojo = lo que se quita)
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(hx, hy, hgw, hh, 1);
fnt(2);
_d = 12;
while (_d >= HBOT) (
  _yy = h2y(_d);
  gfx_set(1, 1, 1, _d == 0 ? 0.10 : 0.045); gfx_line(hx, _yy, hx + hgw - 1, _yy);
  gfx_set(0.50, 0.53, 0.60, 1);
  sprintf(#s, _d > 0 ? "+%d" : "%d", _d); _d > HBOT ? text_r(#s, 0, _yy - 7 * SC, hx - 6 * SC, 14 * SC);
  _d -= 6;
);
_wi = hw; _ncol = floor(hgw / SC);
_spc = 600 / _ncol;
_c = 0;
_yb = hy + hh - 1;
loop(_ncol,
  _age = (_ncol - 1 - _c) * _spc;
  _i0 = _wi - 1 - floor(_age + _spc); _i1 = _wi - 1 - floor(_age);
  _vi = -200; _vo = -200; _vg = 0;
  _i = _i0;
  while (_i <= _i1) (
    _j = _i; _j < 0 ? _j += NH; _j < 0 ? _j += NH;
    _vi = max(_vi, histIn[_j]); _vo = max(_vo, histOut[_j]); _vg = max(_vg, histGR[_j]);
    _i += 1;
  );
  _xx = hx + _c * SC;
  _yi = h2y(_vi); _yo = h2y(_vo);
  gfx_set(0.42, 0.66, 1.0, 0.55); gfx_line(_xx, _yo, _xx, _yb);
  _vg > 0.05 ? ( gfx_set(1.0, 0.36, 0.33, 0.85); gfx_line(_xx, _yi, _xx, _yo); )
             : ( gfx_set(0.62, 0.65, 0.72, 0.35); gfx_line(_xx, _yi, _xx, _yo); );
  // reduccion como linea que cuelga desde arriba
  _yg = hy + hh * clamp(_vg / (HTOP - HBOT), 0, 1);
  _c > 0 ? ( gfx_set(1.0, 0.55, 0.50, 1); gfx_line(_pxx, _pyg, _xx, _yg, 1); );
  _pxx = _xx; _pyg = _yg;
  _c += 1;
);
hit_add(hx, hy, hgw, hh, 100);
// techo
_yt = h2y(slider2);
_hv = hover_id == 101 || (drag && drag_id == 101);
acc(_hv ? 1 : 0.85);
_xx = hx; while (_xx < hx + hgw) ( gfx_line(_xx, _yt, min(_xx + 8 * SC, hx + hgw - 1), _yt); gfx_line(_xx, _yt + 1, min(_xx + 8 * SC, hx + hgw - 1), _yt + 1); _xx += 14 * SC; );
fnt(4); sprintf(#s, "TECHO %.1f dB%s", slider2, slider8 ? "TP" : ""); text_l(#s, hx + 8 * SC, _yt - 16 * SC, 14 * SC);
gfx_circle(hx + hgw - 10 * SC, _yt, 5 * SC, 1, 1);
hit_add(hx, _yt - 7 * SC, hgw, 14 * SC, 101);
fnt(4); _xx = hx + hgw - 8 * SC;
gfx_set(1.0, 0.45, 0.40, 1); gfx_measurestr("SE QUITA", _tw, _th); _xx -= _tw; text_l("SE QUITA", _xx, hy + 6 * SC, 14 * SC);
gfx_set(0.55, 0.78, 1.0, 1); gfx_measurestr("SALIDA", _tw, _th); _xx -= _tw + 14 * SC; text_l("SALIDA", _xx, hy + 6 * SC, 14 * SC);
gfx_set(0.62, 0.65, 0.72, 1); gfx_measurestr("ENTRADA", _tw, _th); _xx -= _tw + 14 * SC; text_l("ENTRADA", _xx, hy + 6 * SC, 14 * SC);
fnt(4); acc(1); sprintf(#s, "GANANCIA +%.1f dB", slider1); text_l(#s, hx + 8 * SC, hy + 6 * SC, 14 * SC);

// ---- medidores
pk_in = max(m_in, pk_in * 0.999); pk_out = max(m_out, pk_out * 0.999); pk_gr = max(pk_gr, m_gr);
_mi = m_in; _mo = m_out; m_in *= 0.82; m_out *= 0.82; m_gr = 0;
_mt = dy + 18 * SC; _mh = dh - 36 * SC; _bw = 18 * SC;
_k = 0;
loop(3,
  _xx = mx0 + 8 * SC + _k * 28 * SC;
  gfx_set(0.13, 0.14, 0.18, 1); gfx_rect(_xx, _mt, _bw, _mh, 1);
  _k == 1 ? (
    _lv = clamp(gr_now / 24, 0, 1);
    gfx_set(1.0, 0.45, 0.40, 1); gfx_rect(_xx, _mt, _bw, _mh * _lv, 1);
    sprintf(#s, "%.1f", -pk_gr);
  ) : (
    _v = _k == 0 ? _mi : _mo;
    _pdb = 20 * log10(_v + 0.000000001);
    _lv = clamp((_pdb + 48) / 60, 0, 1);
    _pdb > -0.1 ? gfx_set(1, 0.35, 0.3, 1) : _pdb > -6 ? gfx_set(0.95, 0.85, 0.35, 1) : gfx_set(0.42, 0.85, 0.55, 1);
    gfx_rect(_xx, _mt + _mh * (1 - _lv), _bw, _mh * _lv, 1);
    _pk = 20 * log10((_k == 0 ? pk_in : pk_out) + 0.000000001);
    _pk > -60 ? sprintf(#s, "%.1f", _pk) : strcpy(#s, "-inf");
    gfx_set(1, 1, 1, 0.6); _yy = _mt + _mh * (1 - clamp((_pk + 48) / 60, 0, 1)); gfx_line(_xx, _yy, _xx + _bw - 1, _yy);
  );
  fnt(4); gfx_set(0.80, 0.82, 0.88, 1); text_c(#s, _xx - 6 * SC, dy, _bw + 12 * SC, 16 * SC);
  gfx_set(0.50, 0.53, 0.60, 1); text_c(_k == 0 ? "IN" : _k == 1 ? "GR" : "OUT", _xx - 6 * SC, _mt + _mh + 2 * SC, _bw + 12 * SC, 16 * SC);
  _k += 1;
);
hit_add(mx0, dy, MW, dh, 103);

// ---- loudness
gfx_set(0.095, 0.105, 0.135, 1); frect(lx0, dy, LW, dh, 6 * SC);
fnt(4); gfx_set(0.55, 0.58, 0.65, 1); text_l("LOUDNESS (LUFS)", lx0 + 12 * SC, dy + 6 * SC, 16 * SC);
function lrow(y, lab, v, big) (
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1); text_l(lab, lx0 + 12 * SC, y, 14 * SC);
  fnt(big ? 7 : 6); v > -69.9 ? sprintf(#s, "%.1f", v) : strcpy(#s, "-");
  big ? acc(1) : gfx_set(0.92, 0.93, 0.96, 1);
  text_l(#s, lx0 + 12 * SC, y + 14 * SC, big ? 30 * SC : 20 * SC);
);
_ly = dy + 30 * SC; _lst = (dh - 40 * SC) / 5;
lrow(_ly, "INTEGRADO", lu_i, 1); _ly += _lst * 1.3;
lrow(_ly, "CORTO (3 s)", lu_s, 0); _ly += _lst;
lrow(_ly, "MOMENTANEO", lu_m, 0); _ly += _lst;
fnt(2); gfx_set(0.55, 0.58, 0.65, 1); text_l("PICO REAL MAX", lx0 + 12 * SC, _ly, 14 * SC);
fnt(6); _tp = 20 * log10(tp_max + 0.0000000001);
_tp > slider2 + 0.05 ? gfx_set(1, 0.45, 0.4, 1) : gfx_set(0.92, 0.93, 0.96, 1);
_tp > -99 ? sprintf(#s, "%.1f dBTP", _tp) : strcpy(#s, "-"); text_l(#s, lx0 + 12 * SC, _ly + 14 * SC, 20 * SC);
// marca de -14 (streaming)
_ly = dy + dh - 22 * SC;
fnt(4); lu_i > -69.9 ? (
  _df = lu_i + 14; abs(_df) < 0.5 ? gfx_set(0.47, 0.88, 0.60, 1) : gfx_set(0.62, 0.65, 0.72, 1);
  sprintf(#s, _df > 0 ? "streaming: lo bajan %.1f dB" : "streaming: lo suben %.1f dB", abs(_df));
  text_l(#s, lx0 + 12 * SC, _ly, 14 * SC);
);
(hover_id == 102) ? ( gfx_set(1, 1, 1, 0.25); gfx_rect(lx0, dy, LW, dh, 0); );
hit_add(lx0, dy, LW, dh, 102);

// ---- panel inferior
gfx_set(0.10, 0.11, 0.14, 1); gfx_rect(0, py - 4 * SC, WW, WH - py + 4 * SC, 1);
_x = 14 * SC; _y = py + 6 * SC; _h = 28 * SC;
fnt(2); gfx_set(0.55, 0.58, 0.65, 1); text_l("ESTILO", _x, _y, _h); _x += 56 * SC;
_k = 0;
loop(5,
  _on = slider5 == _k; _hv = hover_id == 40 + _k;
  _on ? style_rgb(_k, 1) : gfx_set(_hv ? 0.24 : 0.16, _hv ? 0.26 : 0.18, _hv ? 0.31 : 0.23, 1);
  frect(_x, _y, 100 * SC, _h, 5 * SC);
  !_on ? ( style_rgb(_k, 1); gfx_rect(_x + 10 * SC, _y + _h * 0.5 - 3 * SC, 6 * SC, 6 * SC, 1); );
  fnt(5); _on ? gfx_set(0.07, 0.08, 0.10, 1) : gfx_set(0.86, 0.88, 0.92, 1);
  text_c(style_name(_k), _x + (_on ? 0 : 6 * SC), _y, 100 * SC, _h);
  hit_add(_x, _y, 100 * SC, _h, 40 + _k);
  _x += 104 * SC; _k += 1;
);
_x = WW - 14 * SC - 120 * SC;
button(20, _x, _y, 120 * SC, _h, "Auto release", slider6);

_ky = py + 92 * SC; _kr = 26 * SC; _kx = 60 * SC; _ks = 92 * SC;
sprintf(#s, "+%.1f dB", slider1); knob(1, _kx, _ky, _kr, "Ganancia", #s, ctl_get(1), 0, 1); _kx += _ks;
sprintf(#s, "%.1f dB", slider2); knob(2, _kx, _ky, _kr, "Techo", #s, ctl_get(2), 0, 1); _kx += _ks;
fmt_ms(#s, slider3); knob(3, _kx, _ky, _kr, slider6 ? "Release (auto)" : "Release", #s, ctl_get(3), 0, 1); _kx += _ks;
sprintf(#s, "%.1f ms", slider4); knob(4, _kx, _ky, _kr, "Lookahead", slider4 > 0 ? #s : "Apagado", ctl_get(4), 0, 1); _kx += _ks;
sprintf(#s, "%d %%", slider9); knob(5, _kx, _ky, _kr, "Recorte suave", slider9 ? #s : "Apagado", ctl_get(5), 0, 1); _kx += _ks;
sprintf(#s, "%d %%", slider7); knob(6, _kx, _ky, _kr, "Enlace", #s, ctl_get(6), 0, 1); _kx += _ks;
// tarjeta del estilo
_cx = _kx - 30 * SC; _cw = WW - 14 * SC - _cx;
_cw > 200 * SC ? (
  gfx_set(0.13, 0.14, 0.18, 1); frect(_cx, py + 48 * SC, _cw, 84 * SC, 6 * SC);
  acc(1); gfx_rect(_cx, py + 54 * SC, 3 * SC, 72 * SC, 1);
  fnt(5); text_l(style_name(slider5), _cx + 14 * SC, py + 56 * SC, 18 * SC);
  fnt(2); gfx_set(0.72, 0.75, 0.82, 1);
  text_l(style_desc(slider5, 0), _cx + 14 * SC, py + 78 * SC, 16 * SC);
  text_l(style_desc(slider5, 1), _cx + 14 * SC, py + 94 * SC, 16 * SC);
  _lat = (la_n - 1 + 8) / srate * 1000;
  gfx_set(0.50, 0.53, 0.60, 1); sprintf(#s, "Latencia %.2f ms (compensada)", _lat); text_l(#s, _cx + 14 * SC, py + 110 * SC, 16 * SC);
);

// ---- pie
hint_for(hover_id);
gfx_set(0.06, 0.065, 0.085, 1); gfx_rect(0, WH - FOOTH, WW, FOOTH, 1);
fnt(2); gfx_set(0.70, 0.73, 0.80, 1); text_l(#hint, 12 * SC, WH - FOOTH, FOOTH);
slider11 ? ( acc(1); text_r("ESCUCHANDO SOLO LO QUE SE QUITA", WW - 300 * SC, WH - FOOTH, 288 * SC, FOOTH); )
: slider10 ? ( acc(1); text_r("IGUAL VOLUMEN (COMPARANDO)", WW - 300 * SC, WH - FOOTH, 288 * SC, FOOTH); );
